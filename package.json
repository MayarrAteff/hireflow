{
  "name": "hireflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HireFlow — a multi-portal hiring platform (recruiters, candidates, admins).",
  "author": "Mayar Atef <mayar.ateffff@gmail.com>",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc && vite build",
    "preview": "vite preview",
    "generate:routes": "tsr generate",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix && npm run format",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,scss}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/system": "^6.5.0",
    "@mui/x-date-pickers": "^7.29.4",
    "@reduxjs/toolkit": "^2.2.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.28.6",
    "@tanstack/react-query-devtools": "^5.29.0",
    "@tanstack/react-router": "^1.170.36",
    "apexcharts": "^4.3.0",
    "axios": "^1.15.2",
    "dayjs": "^1.11.12",
    "framer-motion": "^11.0.20",
    "material-react-table": "^3.2.1",
    "notistack": "^3.0.1",
    "react": "^18.3.1",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.1",
    "react-icons": "^5.3.0",
    "react-intl": "^6.6.2",
    "react-joyride": "^2.9.3",
    "react-redux": "^9.1.0",
    "simplebar-react": "^3.2.4",
    "stylis-plugin-rtl": "^2.1.1",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.59.7",
    "@tanstack/react-router-devtools": "^1.167.2",
